[Unit]
Description=FaceHub Management Agent
After=network.target

[Service]
Type=simple
User=root
Group=facehub-management
ExecStart=/opt/facehub-management/agent/FaceHubManagement.Agent
Restart=on-failure
RestartSec=2
RuntimeDirectory=facehub-management
RuntimeDirectoryMode=0770
UMask=0007
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
ReadWritePaths=-/etc/ufw -/var/lib/ufw

[Install]
WantedBy=multi-user.target
